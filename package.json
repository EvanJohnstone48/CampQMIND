{
  "name": "motherlode",
  "private": true,
  "description": "A simulated mining valley that explains itself. Camp QMIND build weekend.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @motherlode/server --filter @motherlode/web run dev",
    "dev:server": "pnpm --filter @motherlode/server dev",
    "dev:web": "pnpm --filter @motherlode/web dev",
    "build": "pnpm --filter @motherlode/web build",
    "test": "vitest run && pnpm --filter @motherlode/web test",
    "test:watch": "vitest",
    "test:live": "pnpm --filter @motherlode/web build && pnpm --filter @motherlode/web test:live",
    "typecheck": "pnpm -r typecheck",
    "sim": "pnpm --filter @motherlode/cli sim",
    "narrator:accuracy": "pnpm --filter @motherlode/narrator accuracy"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
