{
  "name": "motherlode",
  "private": true,
  "description": "A simulated mining valley that explains itself. Camp QMIND build weekend.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "dev:server": "pnpm --filter @motherlode/server dev",
    "sim": "pnpm --filter @motherlode/cli sim"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
