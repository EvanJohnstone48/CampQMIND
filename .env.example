# Copy this file to ".env" (same folder) and fill in what you need.
# .env is ignored by git, so your keys never get committed.

# --- AI model (Google Gemini, free tier: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=

# --- Simulation server ---
PORT=8787
SEED=demo
POPULATION=50
# The world waits for someone to press play in the browser; false starts it straight away.
START_PAUSED=true
ROUND_MS=3000
# agents (Lane 2's fuzzy + LLM town) or baseline (the sim's simple brain)
BRAINS=agents

# --- LLM miners (only used when GEMINI_API_KEY is set) ---
GEMINI_MODEL=gemini-2.5-flash-lite
# Share of miners driven by Gemini
LLM_SHARE=0.25
# Requests per minute across all LLM miners: keep under your free-tier quota
LLM_RPM=10
LLM_DAILY_CAP=1000
LLM_TIMEOUT_MS=8000
# An LLM miner re-plans at least this often (shifts), sooner after big events
LLM_REPLAN_EVERY=6

# --- Narrator (Lane 3) ---
# With GEMINI_API_KEY set, the narrator rewords its cards (every rewording is checked). off = templates only.
NARRATOR_LLM=on
# NARRATOR_MODEL=gemini-2.5-flash

# --- Web app ---
# Build-time server address for the web app (default ws://127.0.0.1:8787); ?server= in the URL also works.
# VITE_SERVER_URL=ws://127.0.0.1:8787
